# ==========================================
# ResearchMind Remote Deployment Configuration
# For Linux production environment
# ==========================================
# 使用说明：
# 1. 复制此文件为 .env.remote
# 2. 填写你的 API Keys
# 3. 修改 <YOUR_SERVER_IP> 为你的服务器公网 IP
# 4. 运行 sudo bash setup_nginx.sh 配置 Nginx
# 5. 运行 bash start_linux.sh 启动所有服务
# ==========================================

# ==========================================
# AI Model API Keys (Required)
# ==========================================
# ==========================================
GOOGLE_API_KEY=AIzaSyBhFMILJiPgq_JSBaiTtOZRZonpnkqBNmg
DEEPSEEK_API_KEY=sk-806b949d03eb4c288dd8013b744b1a4b
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_USE=deepseek/deepseek-chat

# ==========================================
# External API Keys (Optional)
# ==========================================
TAVILY_API_KEY=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
MP_API_KEY=AY0i5TZn1C2OeMa6S7PUFZ0S9Yml0Vqq

# ==========================================
# Service Listening Configuration
# ==========================================
# 所有服务监听在 0.0.0.0，允许外部访问
# 通过 Nginx 反向代理统一在 50001 端口提供服务

# Frontend UI (内部端口，Nginx 会转发)
VITE_FRONTEND_HOST=0.0.0.0
VITE_FRONTEND_PORT=50010

# Backend HTTP API (内部端口)
RESEARCHMIND_HTTP_HOST=0.0.0.0
RESEARCHMIND_HTTP_PORT=50002

# WebSocket (内部端口)
RESEARCHMIND_WS_HOST=0.0.0.0
RESEARCHMIND_WS_PORT=50003

# MCP Services (内部服务，不对外暴露)
PAPER_SEARCH_MCP_HOST=127.0.0.1
PAPER_SEARCH_MCP_PORT=50004

SIMULATION_MCP_HOST=127.0.0.1
SIMULATION_MCP_PORT=50005

DATABASE_MCP_HOST=127.0.0.1
DATABASE_MCP_PORT=50006

# ==========================================
# Client Connection Configuration
# ==========================================
# 通过 Nginx 反向代理访问（相对路径）
# 前端会自动使用当前域名 + 这些路径
VITE_API_URL=/api
VITE_API_PORT=50001
VITE_WS_URL=/ws
VITE_WS_PORT=50001

# ==========================================
# MCP Service URLs (Backend 内部调用)
# ==========================================
# 后端服务器内部调用 MCP 服务使用 localhost
PAPER_SEARCH_MCP_URL=http://127.0.0.1:50004/sse
SIMULATION_MCP_URL=http://127.0.0.1:50005/sse
DATABASE_MCP_URL=http://127.0.0.1:50006/sse

# ==========================================
# Logging Configuration
# ==========================================
RESEARCHMIND_LOG_LEVEL=INFO
RESEARCHMIND_DEBUG=false

# ==========================================
# 部署说明
# ==========================================
# 1. 确保服务器防火墙开放 50001 端口
#    Ubuntu/Debian: sudo ufw allow 50001
#    CentOS/RHEL: sudo firewall-cmd --permanent --add-port=50001/tcp && sudo firewall-cmd --reload
#
# 2. 配置 Nginx 反向代理
#    sudo bash setup_nginx.sh
#
# 3. 启动所有服务
#    bash start_linux.sh
#
# 4. 访问应用
#    http://<YOUR_SERVER_IP>:50001
#
# 5. 停止所有服务
#    bash stop_linux.sh

