# ==========================================
# ResearchMind Remote Deployment Configuration (.env.bohr)
# ==========================================
# 用于 Bohrium 等远程部署平台
# 特点：使用相对路径和自动域名检测，支持任意域名部署

# ==========================================
# AI Model API Keys (Required)
# ==========================================
GOOGLE_API_KEY=AIzaSyBhFMILJiPgq_JSBaiTtOZRZonpnkqBNmg
DEEPSEEK_API_KEY=sk-806b949d03eb4c288dd8013b744b1a4b
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_USE=deepseek/deepseek-chat

# ==========================================
# External API Keys (Optional)
# ==========================================
TAVILY_API_KEY=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
MP_API_KEY=ZQHIyULj3gu8DRBhjEHFmFcZ6GvlQtBi

# ==========================================
# Service Listening Configuration (0.0.0.0 = expose to all interfaces)
# ==========================================
# 后端监听所有接口，通过 Nginx 反向代理暴露到外网

# 端口50001: 前端UI - React应用
VITE_FRONTEND_HOST=0.0.0.0
VITE_FRONTEND_PORT=50001

# 端口50002: 后端HTTP API - FastAPI
RESEARCHMIND_HTTP_HOST=0.0.0.0
RESEARCHMIND_HTTP_PORT=50002

# 端口50003: WebSocket连接 - 实时通信
RESEARCHMIND_WS_HOST=0.0.0.0
RESEARCHMIND_WS_PORT=50003

# ========== MCP 服务配置 ==========
# MCP服务仅本地监听，不暴露外网

# 端口50004: Paper Search MCP - 论文搜索服务
PAPER_SEARCH_MCP_HOST=127.0.0.1
PAPER_SEARCH_MCP_PORT=50004

# 端口50005: Simulation MCP - 模拟计算服务
SIMULATION_MCP_HOST=127.0.0.1
SIMULATION_MCP_PORT=50005

# 端口50006: Database MCP - 数据库服务
DATABASE_MCP_HOST=127.0.0.1
DATABASE_MCP_PORT=50006

# ==========================================
# Client Connection Configuration (Auto-detect domain)
# ==========================================
# 前端使用相对路径，自动检测当前访问的域名

# API连接地址 - 使用相对路径（自动检测域名）
#   - 前端会自动转换为: http://your-domain.com/api
VITE_API_URL=/api

# WebSocket连接地址 - 使用相对路径（自动检测域名）
#   - 前端会自动转换为: ws://your-domain.com/ws
VITE_WS_URL=/ws

# Paper Search MCP连接地址 - 后端调用（本地）
PAPER_SEARCH_MCP_URL=http://127.0.0.1:50004/sse

# Simulation MCP连接地址 - 后端调用（本地）
SIMULATION_MCP_URL=http://127.0.0.1:50005/sse

# Database MCP连接地址 - 后端调用（本地）
DATABASE_MCP_URL=http://127.0.0.1:50006/sse

# ==========================================
# Database Configuration
# ==========================================
RESEARCHMIND_DATABASE_URL=sqlite:///./researchmind.db
RESEARCHMIND_REDIS_URL=redis://localhost:6379

# ==========================================
# Logging Configuration
# ==========================================
RESEARCHMIND_LOG_LEVEL=INFO
RESEARCHMIND_DEBUG=false
AGENT_LOG_LEVEL=INFO

# ==========================================
# Agent Configuration
# ==========================================
AGENT_COMMUNICATION_HOST=127.0.0.1
AGENT_COMMUNICATION_PORT=50003

