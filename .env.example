VITE_API_URL=http://127.0.0.1:50002

# WebSocket连接地址 - 实时通信
#   - 端口50003: WebSocket服务
#   - 路径/ws: WebSocket端点
#   - 本地: ws://127.0.0.1:50003/ws
#   - 远程: ws://域名:50003/ws
VITE_WS_URL=ws://127.0.0.1:50003/ws  # 本地开发使用，远程部署时改为 ws://域名:50003/ws

# Paper Search MCP连接地址 - 论文搜索服务
#   - 端口50004: Paper Search MCP服务
#   - 路径/sse: Server-Sent Events端点
#   - 本地: http://127.0.0.1:50004/sse
#   - 远程: http://域名:50004/sse
PAPER_SEARCH_MCP_URL=http://127.0.0.1:50004/sse

# Simulation MCP连接地址 - 模拟计算服务
#   - 端口50005: Simulation MCP服务
#   - 路径/sse: Server-Sent Events端点
#   - 本地: http://127.0.0.1:50005/sse
#   - 远程: http://域名:50005/sse
SIMULATION_MCP_URL=http://127.0.0.1:50005/sse

# Database MCP连接地址 - 数据库服务
#   - 端口50006: Database MCP服务
#   - 路径/sse: Server-Sent Events端点
#   - 本地: http://127.0.0.1:50006/sse
#   - 远程: http://域名:50006/sse
DATABASE_MCP_URL=http://127.0.0.1:50006/sse

