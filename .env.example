# ==========================================
# ResearchMind Environment Configuration
# ==========================================
# Copy this file to .env and fill in your API keys

# ==========================================
# AI Model API Keys (Required)
# ==========================================

# Google Gemini API Key (Required for main agent)
# Get it from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# DeepSeek API Key (Optional, alternative model)
# Get it from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
MODEL_BASE_URL=https://api.deepseek.com/v1

# ==========================================
# Model Selection
# ==========================================
# Choose which model to use:
# - deepseek/deepseek-chat (faster, cheaper)
# - gemini/gemini-2.5-flash (more capable)
MODEL_USE=deepseek/deepseek-chat

# ==========================================
# External API Keys (Optional)
# ==========================================

# Tavily API Key (for web search)
# Get it from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Materials Project API Key (for materials database)
# Get it from: https://materialsproject.org/api
MP_API_KEY=your_materials_project_api_key_here

# ==========================================
# Server Configuration
# ==========================================

# Main server settings
RESEARCHMIND_HOST=127.0.0.1
RESEARCHMIND_PORT=8000
RESEARCHMIND_DEBUG=false
RESEARCHMIND_LOG_LEVEL=INFO

# CORS Settings (for frontend)
RESEARCHMIND_ALLOW_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:80"]

# ==========================================
# MCP Server URLs
# ==========================================
# These are used when running in Docker or distributed mode
# For local development, these can be left as default

DATABASE_MCP_URL=http://localhost:5002/sse
SIMULATION_MCP_URL=http://localhost:5003/sse
PAPER_SEARCH_MCP_URL=http://localhost:50001/sse

# ==========================================
# Database Configuration
# ==========================================

# SQLite (default for development)
RESEARCHMIND_DATABASE_URL=sqlite:///./researchmind.db

# PostgreSQL (for production, optional)
# RESEARCHMIND_DATABASE_URL=postgresql://username:password@localhost:5432/researchmind

# ==========================================
# Redis Configuration (Optional)
# ==========================================

RESEARCHMIND_REDIS_URL=redis://localhost:6379

# ==========================================
# Frontend Configuration
# ==========================================

# API endpoints for frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# ==========================================
# Agent Configuration
# ==========================================

AGENT_LOG_LEVEL=INFO
AGENT_COMMUNICATION_HOST=127.0.0.1
AGENT_COMMUNICATION_PORT=8000

