# ==========================================
# ResearchMind Environment Configuration
# ==========================================
# Copy this file to .env and fill in your API keys

# ==========================================
# AI Model API Keys (Required)
# ==========================================

# Google Gemini API Key (Required for main agent)
# Get it from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# DeepSeek API Key (Optional, alternative model)
# Get it from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
MODEL_BASE_URL=https://api.deepseek.com/v1

# ==========================================
# Model Selection
# ==========================================
# Choose which model to use:
# - deepseek/deepseek-chat (faster, cheaper)
# - gemini/gemini-2.5-flash (more capable)
MODEL_USE=deepseek/deepseek-chat

# ==========================================
# External API Keys (Optional)
# ==========================================

# Tavily API Key (for web search)
# Get it from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Materials Project API Key (for materials database)
# Get it from: https://materialsproject.org/api
MP_API_KEY=your_materials_project_api_key_here

# ==========================================
# Service Listening Configuration (0.0.0.0 = expose to all interfaces)
# ==========================================
# External ports (Direct access, no reverse proxy)
VITE_FRONTEND_HOST=0.0.0.0
VITE_FRONTEND_PORT=50001
RESEARCHMIND_WS_HOST=127.0.0.1
RESEARCHMIND_WS_PORT=50003
PAPER_SEARCH_MCP_HOST=127.0.0.1
PAPER_SEARCH_MCP_PORT=50004
PAPER_SEARCH_HOST=127.0.0.1
SIMULATION_MCP_HOST=127.0.0.1
SIMULATION_MCP_PORT=50005
SIMULATION_HOST=127.0.0.1
DATABASE_MCP_HOST=127.0.0.1
DATABASE_MCP_PORT=50002
DATABASE_HOST=127.0.0.1

# Backend API ports (localhost only)
RESEARCHMIND_HTTP_HOST=127.0.0.1
RESEARCHMIND_HTTP_PORT=50006

# ==========================================
# Client Connection Configuration (use actual domain/IP)
# ==========================================
# Direct access to services (no reverse proxy)
# 后端API端口: 50006
RESEARCHMIND_API_URL=http://dyum1393797.bohrium.tech:50006
VITE_API_URL=http://dyum1393797.bohrium.tech:50006
VITE_WS_URL=ws://dyum1393797.bohrium.tech:50003/ws
PAPER_SEARCH_MCP_URL=http://dyum1393797.bohrium.tech:50004/sse
SIMULATION_MCP_URL=http://dyum1393797.bohrium.tech:50005/sse
DATABASE_MCP_URL=http://dyum1393797.bohrium.tech:50002/sse

# CORS Settings (for frontend)
# Format: JSON array of allowed origins
# Leave empty to use defaults (includes localhost, 127.0.0.1, and wildcard)
# RESEARCHMIND_ALLOW_ORIGINS=["http://dyum1393797.bohrium.tech:50001", "http://192.168.1.100:50001", "*"]

# ==========================================
# Database Configuration
# ==========================================

# SQLite (default for development)
RESEARCHMIND_DATABASE_URL=sqlite:///./researchmind.db

# PostgreSQL (for production, optional)
# RESEARCHMIND_DATABASE_URL=postgresql://username:password@localhost:5432/researchmind

# ==========================================
# Redis Configuration (Optional)
# ==========================================

RESEARCHMIND_REDIS_URL=redis://localhost:6379

# ==========================================
# Agent Configuration
# ==========================================

AGENT_LOG_LEVEL=INFO
AGENT_COMMUNICATION_HOST=127.0.0.1
AGENT_COMMUNICATION_PORT=50003
