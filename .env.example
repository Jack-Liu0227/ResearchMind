# ========== EXTERNAL PORTS (Direct access, no reverse proxy) ==========

# 端口50001: 前端UI - React应用
#   - 监听: 0.0.0.0:50001（允许外部访问）
#   - 访问: http://127.0.0.1:50001（本地）或 http://域名:50001（远程）
VITE_FRONTEND_HOST=0.0.0.0
VITE_FRONTEND_PORT=50001

# 端口50002: 后端HTTP API - FastAPI
#   - 用途: 处理CIF上传、结构转换、API请求
#   - 监听: 0.0.0.0:50002（允许外部访问）
#   - 前端调用: http://127.0.0.1:50002（本地）或 http://域名:50002（远程）
RESEARCHMIND_HTTP_HOST=0.0.0.0
RESEARCHMIND_HTTP_PORT=50002
RESEARCHMIND_API_URL=http://127.0.0.1:50002

# 端口50003: WebSocket连接 - 实时通信
#   - 用途: 前端与后端的实时消息传输
#   - 监听: 0.0.0.0:50003（允许外部访问）
#   - 连接: ws://127.0.0.1:50003/ws（本地）或 ws://域名:50003/ws（远程）
RESEARCHMIND_WS_HOST=0.0.0.0
RESEARCHMIND_WS_PORT=50003

# ========== MCP 服务配置说明 ==========
#
# 为什么MCP服务的HOST设为127.0.0.1而不是0.0.0.0？
# 为什么MCP服务不需要暴露外网？
#
# 1. 架构设计：
#    - MCP服务是内部服务，仅被后端HTTP API调用
#    - 前端不直接连接MCP服务
#    - 因此MCP服务不需要暴露到外网
#
# 2. 为什么不需要暴露外网？
#
#    a) 功能职责分离：
#       - 后端HTTP API（50006）：处理所有外部请求，负责权限验证
#       - MCP服务（50002/50004/50005）：处理内部计算和数据处理
#       - 前端无需知道MCP服务的存在
#
#    b) 请求流程：
#       前端请求 → 后端API验证权限 → 后端API调用MCP服务 → 返回结果
#
#       例如：搜索论文
#       1. 前端发送搜索请求到后端API（50006）
#       2. 后端API验证用户权限
#       3. 后端API调用Paper Search MCP（50004）进行搜索
#       4. MCP返回结果给后端API
#       5. 后端API返回结果给前端
#
#       前端永远不会直接连接到50004端口
#
#    c) 安全性考虑：
#       - 如果MCP暴露外网，任何人都可以直接调用MCP服务
#       - 绕过后端API的权限验证
#       - 可能导致数据泄露或被滥用
#       - 限制MCP仅本地访问，确保所有请求都经过后端API验证
#
#    d) 资源保护：
#       - MCP服务执行计算密集型任务（论文搜索、结构模拟）
#       - 如果暴露外网，可能被恶意用户滥用
#       - 后端API可以实现速率限制、请求队列等保护机制
#
#    e) 版本控制和升级：
#       - MCP服务可以独立升级而不影响前端
#       - 后端API作为中间层，可以处理版本兼容性
#       - 前端无需关心MCP服务的具体实现
#
# 3. 通信流程：
#    前端 → 后端API(50002) → MCP服务(50004/50005/50006)
#
#    前端无法直接访问MCP服务，必须通过后端API
#
# 4. 配置规则：
#    - 监听地址（HOST）：127.0.0.1（仅本地）
#    - 连接地址（URL）：使用域名（供后端API调用）
#    - 前端访问：只能通过后端API的/api/*端点
#
# 端口50004: Paper Search MCP - 论文搜索服务
#   - 用途: 论文搜索和检索功能
#   - 监听: 127.0.0.1:50004（仅本地，不暴露外网）
#   - 后端调用: http://127.0.0.1:50004/sse（本地调用）
#   - 前端无法直接访问，必须通过后端API
#
# 变量说明：
# PAPER_SEARCH_MCP_HOST=127.0.0.1
#   - 作用：Paper Search MCP服务监听的地址
#   - 含义：服务绑定到127.0.0.1（仅本地）
#   - 使用：mcp_servers/paper_search/server.py中的uvicorn.run(host=...)
#   - 为什么是127.0.0.1：MCP服务是内部服务，不需要暴露到外网
#
# PAPER_SEARCH_MCP_PORT=50004
#   - 作用：Paper Search MCP服务监听的端口
#   - 含义：服务监听端口50004
#   - 使用：mcp_servers/paper_search/server.py中的uvicorn.run(port=...)
#   - 为什么是50004：与其他MCP服务的端口不冲突
#
PAPER_SEARCH_MCP_HOST=127.0.0.1
PAPER_SEARCH_MCP_PORT=50004

# 端口50005: Simulation MCP - 模拟计算服务
#   - 用途: 晶体结构模拟和计算
#   - 监听: 127.0.0.1:50005（仅本地，不暴露外网）
#   - 后端调用: http://127.0.0.1:50005/sse（本地调用）
#   - 前端无法直接访问，必须通过后端API
#
# 变量说明：
# SIMULATION_MCP_HOST=127.0.0.1
#   - 作用：Simulation MCP服务监听的地址
#   - 含义：服务绑定到127.0.0.1（仅本地）
#   - 使用：mcp_servers/simulation/server.py中的uvicorn.run(host=...)
#   - 为什么是127.0.0.1：MCP服务是内部服务，不需要暴露到外网
#
# SIMULATION_MCP_PORT=50005
#   - 作用：Simulation MCP服务监听的端口
#   - 含义：服务监听端口50005
#   - 使用：mcp_servers/simulation/server.py中的uvicorn.run(port=...)
#   - 为什么是50005：与其他MCP服务的端口不冲突
#
SIMULATION_MCP_HOST=127.0.0.1
SIMULATION_MCP_PORT=50005

# 端口50006: Database MCP - 数据库服务
#   - 用途: 数据库操作和查询
#   - 监听: 127.0.0.1:50006（仅本地，不暴露外网）
#   - 后端调用: http://127.0.0.1:50006/sse（本地调用）
#   - 前端无法直接访问，必须通过后端API
#
# 变量说明：
# DATABASE_MCP_HOST=127.0.0.1
#   - 作用：Database MCP服务监听的地址
#   - 含义：服务绑定到127.0.0.1（仅本地）
#   - 使用：mcp_servers/database_call/server.py中的uvicorn.run(host=...)
#   - 为什么是127.0.0.1：MCP服务是内部服务，不需要暴露到外网
#
# DATABASE_MCP_PORT=50006
#   - 作用：Database MCP服务监听的端口
#   - 含义：服务监听端口50006
#   - 使用：mcp_servers/database_call/server.py中的uvicorn.run(port=...)
#   - 为什么是50006：与其他MCP服务的端口不冲突
#
DATABASE_MCP_HOST=127.0.0.1
DATABASE_MCP_PORT=50006

# ==========================================
# Vite Frontend Development Server Configuration
# ==========================================
# Vite开发服务器配置 - 用于 npm run dev

# 允许的主机列表 - 用于Vite开发服务器的allowedHosts配置
#   - 默认: 'all' (允许所有主机)
#   - 指定域名: 'example.com,localhost,127.0.0.1'
#   - 多个域名用逗号分隔，不需要端口号
#   - 如果不设置此变量，默认允许所有主机
# VITE_ALLOWED_HOSTS=example.com,localhost,127.0.0.1

# HMR (Hot Module Replacement) 配置 - 用于开发时的热更新
#   - VITE_HMR_HOST: HMR服务器的主机名（前端连接地址）
#   - VITE_HMR_PORT: HMR服务器的端口
#   - VITE_HMR_PROTOCOL: HMR协议 (ws 或 wss)
#   - 本地开发: localhost:50001
#   - 远程开发: example.com:50001
# VITE_HMR_HOST=example.com
# VITE_HMR_PORT=50001
# VITE_HMR_PROTOCOL=ws

# ==========================================
# Client Connection Configuration (use actual domain/IP)
# ==========================================
# 前端连接配置 - 直接访问各个服务（无反向代理）

# API连接地址 - 前端调用后端API的地址
#   - 端口50002: 后端HTTP API
#   - 本地: http://127.0.0.1:50002
