# ==========================================
# Service Listening Configuration
# ==========================================
#
# 配置选项 1：直接暴露（开发环境）
# VITE_FRONTEND_HOST=0.0.0.0
# RESEARCHMIND_HTTP_HOST=0.0.0.0
# RESEARCHMIND_WS_HOST=0.0.0.0
#
# 配置选项 2：使用 Nginx 反向代理（生产环境，推荐）
# 所有服务监听在 127.0.0.1，通过 Nginx 统一 50001 端口访问
# 参考 NGINX_SETUP.md 了解详情

# Frontend UI (内部端口，Nginx 会转发到 50001)
VITE_FRONTEND_HOST=127.0.0.1
VITE_FRONTEND_PORT=50010

# Backend HTTP API (内部端口)
RESEARCHMIND_HTTP_HOST=127.0.0.1
RESEARCHMIND_HTTP_PORT=50002

# WebSocket (内部端口)
RESEARCHMIND_WS_HOST=127.0.0.1
RESEARCHMIND_WS_PORT=50003

# MCP Services (Internal only)
PAPER_SEARCH_MCP_HOST=127.0.0.1
PAPER_SEARCH_MCP_PORT=50004

SIMULATION_MCP_HOST=127.0.0.1
SIMULATION_MCP_PORT=50005

DATABASE_MCP_HOST=127.0.0.1
DATABASE_MCP_PORT=50006

# ==========================================
# Client Connection Configuration
# ==========================================
# 使用相对路径 + 端口配置，支持自动域名检测
# 前端会自动转换为: http://your-domain.com:50001/api
# WebSocket 会自动转换为: ws://your-domain.com:50001/ws

# VITE_API_URL=/api
# VITE_API_PORT=50001
# VITE_WS_URL=/ws
# VITE_WS_PORT=50001
VITE_API_URL=http://127.0.0.1:50002
VITE_WS_URL=ws://127.0.0.1:50003/ws
# ==========================================
# Logging Configuration
# ==========================================
RESEARCHMIND_LOG_LEVEL=INFO
RESEARCHMIND_DEBUG=false

