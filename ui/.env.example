# ResearchMind UI Environment Variables

# API Configuration
# Leave empty to auto-detect from current hostname
# Or set explicitly for remote deployment
# Direct access to services (no reverse proxy)
# Backend API port: 50006
# VITE_API_URL=http://dyum1393797.bohrium.tech:50006
# VITE_WS_URL=ws://dyum1393797.bohrium.tech:50003/ws

# Development Configuration
VITE_DEV_MODE=true
VITE_LOG_LEVEL=debug

# Feature Flags
VITE_ENABLE_VOICE=false
VITE_ENABLE_FILE_UPLOAD=true
VITE_ENABLE_STRUCTURE_VIEWER=true

# Analytics (Optional)
VITE_ANALYTICS_ID=